{
  "name": "dsh-git-connector",
  "version": "0.1.3",
  "description": "Git repository connector for DeepSeek Harness: name-addressed repo profiles, work-copy operations (clone/fetch/pull/push/commit), forge API tools (Gitea/Forgejo/GitHub), keys kept in the DSH credential center, and per-repo safety flags (TLS bypass, overwrite, force-push).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "git",
    "gitea",
    "forgejo",
    "github",
    "repository",
    "connector"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sycada/dsh-git-connector.git"
  },
  "homepage": "https://github.com/Sycada/dsh-git-connector",
  "bugs": {
    "url": "https://github.com/Sycada/dsh-git-connector/issues"
  },
  "author": "Sycada"
}
